# Copy to .env.local (git-ignored) and fill in. Never commit the key.
# The gateway: litellm (default; LiteLLM runs the MCP tools) or apim (Azure API Management; this server runs them).
CHAT_GATEWAY=litellm
# litellm: LiteLLM's base URL (requests go to /v1/responses below it).
# apim: API Management's OpenAI v1 base, https://<apim>.azure-api.net/openai/v1 (requests go to /responses below it).
GATEWAY_URL=https://<litellm-gateway-host>
CHAT_MODEL=gpt-6-luna
# litellm only: the team's virtual key. Not read in apim mode.
LITELLM_API_KEY=<team-virtual-key>
UI_TENANT_ID=<tenant-id>
UI_CLIENT_ID=<app-registration-client-id>
UI_SCOPE=Chat.Use
UI_ORIGIN=http://localhost:3000
# Optional: only these users may chat. Without it, every user who can sign in to the app registration may.
# ALLOWED_USER_OBJECT_IDS=<user-object-id>,<another-user-object-id>
# Optional: what the page shows and what the model is told (defaults: a generic chat over the gateway's MCP tools).
# CHAT_TITLE=Team notes
# CHAT_INTRO=The assistant adds and lists the team's notes.
# CHAT_INSTRUCTIONS=You help a team manage notes with the notes tools. Keep answers short.
# The gateway app registration's scope: the user's own token for the gateway (see README).
# litellm: optional, only when LiteLLM runs the Agent 365 guardrail. apim: required.
# GATEWAY_SCOPE=api://<gateway-app-client-id>/<scope-name>
# apim only, required: the MCP servers API Management exposes, comma-separated label=url.
# MCP_SERVERS=notes=https://<apim>.azure-api.net/notes/mcp
# Optional: OpenTelemetry to Application Insights, sent with your Azure CLI sign-in (Monitoring Metrics Publisher role).
# APPLICATIONINSIGHTS_CONNECTION_STRING=<connection-string>
